<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScoolManager.Desktop.ViewModels.Pages"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="ScoolManager.Desktop.Views.Pages.RelatoriosView"
             x:DataType="vm:RelatoriosViewModel">

    <Design.DataContext>
        <vm:RelatoriosViewModel/>
    </Design.DataContext>

    <!-- ================================================================
         RECURSOS: mesma paleta de FinanceiroView.axaml / EscolaView.axaml.
         ================================================================ -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="OnSurfaceBrush" Color="#DAE2FD"/>
        <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#C2C6D6"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#ADC6FF"/>
        <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#4D8EFF"/>

        <LinearGradientBrush x:Key="NeoCardGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#171F33" Offset="0"/>
            <GradientStop Color="#111B2E" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- ================================================================
         ESTILOS
         ================================================================ -->
    <UserControl.Styles>

        <Style Selector="Border.neo-card">
            <Setter Property="Background" Value="{StaticResource NeoCardGradientBrush}"/>
            <Setter Property="BorderBrush" Value="#1A8C909F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="inset 1 1 0 0 #0DFFFFFF, 8 8 16 0 #66000000"/>
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.link:pointerover"><Setter Property="Opacity" Value="0.8"/></Style>

        <!-- Cartão clicável da galeria: o Button só captura o clique/hover;
             a aparência (fundo gradiente, borda, sombra) vive no Border.neo-card
             lá dentro, reaproveitando o mesmo estilo comprovado das outras views. -->
        <Style Selector="Button.cartao-relatorio">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.cartao-relatorio:pointerover Border.neo-card">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryContainerBrush}"/>
        </Style>

        <Style Selector="TextBlock.campo-label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
        </Style>

        <Style Selector="TextBlock.col-header">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style Selector="TextBlock.col-cell">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

    </UserControl.Styles>

    <!-- ================================================================
         CONTEÚDO
         ================================================================ -->
    <Panel>
        <ScrollViewer>
            <StackPanel Margin="32" Spacing="20" MaxWidth="1400">

                <!-- Cabeçalho -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Relatórios" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Dashboard" FontSize="12" Opacity="0.6"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        <TextBlock Text="›" FontSize="12" Opacity="0.4"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                        <TextBlock Text="Relatórios" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                           Foreground="{StaticResource OnSurfaceVariantBrush}"
                           Text="Selecione um relatório para configurar os filtros e gerar a pré-visualização."/>

                <!-- Galeria dos 7 relatórios (SM_Flow.md > View 6) -->
                <ItemsControl ItemsSource="{Binding RelatoriosDisponiveis}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RelatorioTipoItem">
                            <Button Classes="cartao-relatorio" Width="300" Margin="0,0,16,16"
                                    Command="{Binding $parent[ItemsControl].((vm:RelatoriosViewModel)DataContext).AbrirConfigurarRelatorioCommand}"
                                    CommandParameter="{Binding}">
                                <Border Classes="neo-card" Padding="20">
                                    <StackPanel Spacing="14">

                                        <Border Width="40" Height="40" CornerRadius="10" Background="#1A4D8EFF">
                                            <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                                         Foreground="{StaticResource PrimaryBrush}"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OnSurfaceBrush}"/>
                                            <TextBlock Text="{Binding Descricao}" FontSize="12" Opacity="0.65"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Configurar relatório" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="14" Height="14"
                                                                         Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ================================================================
             OVERLAY DOS MODAIS
             ================================================================ -->
        <Border Background="#99000000" IsVisible="{Binding AlgumModalAberto}" ZIndex="500">
            <Border Classes="neo-card" MaxWidth="900" Padding="24" ClipToBounds="True"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <Panel>

                <!-- ======================================================
                     Configurar Relatório - formulário de filtros (Fase 3).
                     Só mostra os campos relevantes para o tipo selecionado
                     (MostrarFiltroXxx no ViewModel).
                     ====================================================== -->
                <StackPanel Spacing="16" Width="480" IsVisible="{Binding ModalConfigurarVisivel}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}">
                        <Run Text="Configurar: "/><Run Text="{Binding RelatorioSelecionado.Titulo}"/>
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Opacity="0.65"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"
                               Text="{Binding RelatorioSelecionado.Descricao}"/>

                    <StackPanel Spacing="6" IsVisible="{Binding MostrarFiltroPeriodo}">
                        <TextBlock Classes="campo-label" Text="Período"/>
                        <ComboBox SelectedItem="{Binding FiltroAtual.Periodo}" HorizontalAlignment="Stretch">
                            <x:String>Este mês</x:String>
                            <x:String>Mês passado</x:String>
                            <x:String>Este ano</x:String>
                            <x:String>Personalizado</x:String>
                        </ComboBox>
                        <StackPanel Spacing="6" Margin="0,4,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="campo-label" FontSize="11" Text="Data Início"/>
                                <DatePicker SelectedDate="{Binding FiltroAtual.DataInicio}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="campo-label" FontSize="11" Text="Data Fim"/>
                                <DatePicker SelectedDate="{Binding FiltroAtual.DataFim}" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding MostrarFiltroAnoLectivo}">
                        <TextBlock Classes="campo-label" Text="Ano Lectivo"/>
                        <TextBox Text="{Binding FiltroAtual.AnoLectivo}" PlaceholderText="ex.: 2026/2027"/>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding MostrarFiltroTurmaClasse}">
                        <Grid ColumnDefinitions="*,12,*">
                            <StackPanel Grid.Column="0" Spacing="6" MinWidth="0">
                                <TextBlock Classes="campo-label" Text="Classe"/>
                                <TextBox Text="{Binding FiltroAtual.Classe}" PlaceholderText="ex.: 10ª" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6" MinWidth="0">
                                <TextBlock Classes="campo-label" Text="Turma"/>
                                <TextBox Text="{Binding FiltroAtual.Turma}" PlaceholderText="ex.: GRSI A" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding MostrarFiltroMetodoPagamento}">
                        <TextBlock Classes="campo-label" Text="Método de Pagamento"/>
                        <ComboBox SelectedItem="{Binding FiltroAtual.MetodoPagamento}" HorizontalAlignment="Stretch">
                            <x:String>Todos</x:String>
                            <x:String>Numerário</x:String>
                            <x:String>Transferência</x:String>
                            <x:String>TPA</x:String>
                        </ComboBox>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Classes="link" Content="Fechar" Command="{Binding FecharModalCommand}"/>
                        <Button Grid.Column="2" Classes="link" Content="Pré-Visualizar"
                                Foreground="{StaticResource PrimaryBrush}"
                                Command="{Binding GerarPreVisualizacaoCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- ======================================================
                     Pré-Visualizar - tabela de resultados (Fase 4)
                     ====================================================== -->
                <StackPanel Spacing="14" Width="820" IsVisible="{Binding ModalPreVisualizarVisivel}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}">
                        <Run Text="Pré-Visualização: "/><Run Text="{Binding RelatorioSelecionado.Titulo}"/>
                    </TextBlock>

                    <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="8">

                            <!-- Matrículas -->
                            <Grid IsVisible="{Binding MostrarMatriculas}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="2*,1.2*,*,*,1.2*,*" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="col-header" Text="Aluno"/>
                                    <TextBlock Grid.Column="1" Classes="col-header" Text="Nº Matrícula"/>
                                    <TextBlock Grid.Column="2" Classes="col-header" Text="Classe"/>
                                    <TextBlock Grid.Column="3" Classes="col-header" Text="Turma"/>
                                    <TextBlock Grid.Column="4" Classes="col-header" Text="Data"/>
                                    <TextBlock Grid.Column="5" Classes="col-header" Text="Estado"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadoMatriculas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatriculaRelatorioItem">
                                            <Grid ColumnDefinitions="2*,1.2*,*,*,1.2*,*" Margin="0,4">
                                                <TextBlock Grid.Column="0" Classes="col-cell" Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Aluno}"/>
                                                <TextBlock Grid.Column="1" Classes="col-cell" Text="{Binding NumeroMatricula}"/>
                                                <TextBlock Grid.Column="2" Classes="col-cell" Text="{Binding Classe}"/>
                                                <TextBlock Grid.Column="3" Classes="col-cell" Text="{Binding Turma}"/>
                                                <TextBlock Grid.Column="4" Classes="col-cell" Text="{Binding DataMatricula}"/>
                                                <TextBlock Grid.Column="5" Classes="col-cell" Text="{Binding Estado}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Lista de Alunos -->
                            <Grid IsVisible="{Binding MostrarAlunos}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="2*,1.2*,*,*,1.2*,1.2*" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="col-header" Text="Nome"/>
                                    <TextBlock Grid.Column="1" Classes="col-header" Text="Nº Matrícula"/>
                                    <TextBlock Grid.Column="2" Classes="col-header" Text="Classe"/>
                                    <TextBlock Grid.Column="3" Classes="col-header" Text="Turma"/>
                                    <TextBlock Grid.Column="4" Classes="col-header" Text="Situação"/>
                                    <TextBlock Grid.Column="5" Classes="col-header" Text="Contacto"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadoAlunos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AlunoRelatorioItem">
                                            <Grid ColumnDefinitions="2*,1.2*,*,*,1.2*,1.2*" Margin="0,4">
                                                <TextBlock Grid.Column="0" Classes="col-cell" Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Nome}"/>
                                                <TextBlock Grid.Column="1" Classes="col-cell" Text="{Binding NumeroMatricula}"/>
                                                <TextBlock Grid.Column="2" Classes="col-cell" Text="{Binding Classe}"/>
                                                <TextBlock Grid.Column="3" Classes="col-cell" Text="{Binding Turma}"/>
                                                <TextBlock Grid.Column="4" Classes="col-cell" Text="{Binding Situacao}"/>
                                                <TextBlock Grid.Column="5" Classes="col-cell" Text="{Binding Contacto}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Propinas (Pagas ou em Atraso) -->
                            <Grid IsVisible="{Binding MostrarPropinas}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="2*,1.2*,*,1.2*,1.2*,1*" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="col-header" Text="Aluno"/>
                                    <TextBlock Grid.Column="1" Classes="col-header" Text="Referência"/>
                                    <TextBlock Grid.Column="2" Classes="col-header" Text="Valor"/>
                                    <TextBlock Grid.Column="3" Classes="col-header" Text="Vencimento"/>
                                    <TextBlock Grid.Column="4" Classes="col-header" Text="Pagamento"/>
                                    <TextBlock Grid.Column="5" Classes="col-header" Text="Estado"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadoPropinas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PropinaRelatorioItem">
                                            <Grid ColumnDefinitions="2*,1.2*,*,1.2*,1.2*,1*" Margin="0,4">
                                                <TextBlock Grid.Column="0" Classes="col-cell" Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Aluno}"/>
                                                <TextBlock Grid.Column="1" Classes="col-cell" Text="{Binding Referencia}"/>
                                                <TextBlock Grid.Column="2" Classes="col-cell" Text="{Binding Valor}"/>
                                                <TextBlock Grid.Column="3" Classes="col-cell" Text="{Binding DataVencimento}"/>
                                                <TextBlock Grid.Column="4" Classes="col-cell" Text="{Binding DataPagamento}"/>
                                                <TextBlock Grid.Column="5" Classes="col-cell" Text="{Binding Estado}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Entradas / Saídas -->
                            <Grid IsVisible="{Binding MostrarMovimentos}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="1.2*,2*,1.2*,1.2*,*" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="col-header" Text="Data"/>
                                    <TextBlock Grid.Column="1" Classes="col-header" Text="Descrição"/>
                                    <TextBlock Grid.Column="2" Classes="col-header" Text="Categoria"/>
                                    <TextBlock Grid.Column="3" Classes="col-header" Text="Valor"/>
                                    <TextBlock Grid.Column="4" Classes="col-header" Text="Tipo"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadoMovimentos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RelatorioMovimentoItem">
                                            <Grid ColumnDefinitions="1.2*,2*,1.2*,1.2*,*" Margin="0,4">
                                                <TextBlock Grid.Column="0" Classes="col-cell" Text="{Binding Data}"/>
                                                <TextBlock Grid.Column="1" Classes="col-cell" Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Descricao}"/>
                                                <TextBlock Grid.Column="2" Classes="col-cell" Text="{Binding Categoria}"/>
                                                <TextBlock Grid.Column="3" Classes="col-cell" Text="{Binding Valor}"/>
                                                <TextBlock Grid.Column="4" Classes="col-cell" Text="{Binding Tipo}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- Fluxo de Caixa -->
                            <Grid IsVisible="{Binding MostrarFluxoCaixa}" RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="1.2*,*,*,*,*" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0" Classes="col-header" Text="Período"/>
                                    <TextBlock Grid.Column="1" Classes="col-header" Text="Saldo Inicial"/>
                                    <TextBlock Grid.Column="2" Classes="col-header" Text="Entradas"/>
                                    <TextBlock Grid.Column="3" Classes="col-header" Text="Saídas"/>
                                    <TextBlock Grid.Column="4" Classes="col-header" Text="Saldo Final"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ResultadoFluxoCaixa}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FluxoCaixaRelatorioItem">
                                            <Grid ColumnDefinitions="1.2*,*,*,*,*" Margin="0,4">
                                                <TextBlock Grid.Column="0" Classes="col-cell" Foreground="{StaticResource OnSurfaceBrush}" Text="{Binding Periodo}"/>
                                                <TextBlock Grid.Column="1" Classes="col-cell" Text="{Binding SaldoInicial}"/>
                                                <TextBlock Grid.Column="2" Classes="col-cell" Text="{Binding TotalEntradas}"/>
                                                <TextBlock Grid.Column="3" Classes="col-cell" Text="{Binding TotalSaidas}"/>
                                                <TextBlock Grid.Column="4" Classes="col-cell" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Text="{Binding SaldoFinal}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Button Grid.Column="0" Classes="link" Content="Voltar" Command="{Binding VoltarConfigurarCommand}"/>
                        <Button Grid.Column="2" Classes="link" Content="Exportar PDF" Command="{Binding ExportarPdfCommand}"/>
                        <Button Grid.Column="3" Classes="link" Content="Exportar Excel" Command="{Binding ExportarExcelCommand}"/>
                        <Button Grid.Column="4" Classes="link" Content="Imprimir" Command="{Binding ImprimirCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- ======================================================
                     Exportação / Impressão (Fases 5-7 - placeholder, sem
                     geração de ficheiro real por agora)
                     ====================================================== -->
                <StackPanel Spacing="14" Width="420" IsVisible="{Binding ModalExportacaoVisivel}">
                    <TextBlock Text="Exportação" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceBrush}"/>
                    <TextBlock Text="{Binding MensagemExportacao}" TextWrapping="Wrap" FontSize="13"
                               Foreground="{StaticResource OnSurfaceVariantBrush}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="1" Classes="link" Content="Fechar" Command="{Binding FecharModalCommand}"/>
                    </Grid>
                </StackPanel>

              </Panel>
            </Border>
        </Border>

    </Panel>

</UserControl>
