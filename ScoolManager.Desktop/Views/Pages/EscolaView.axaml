<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScoolManager.Desktop.ViewModels.Pages"
             xmlns:models="using:ScoolManager.Desktop.Models"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="ScoolManager.Desktop.Views.Pages.EscolaView"
             x:DataType="vm:EscolaViewModel"
             x:Name="RaizEscolaView">

    <Design.DataContext>
        <vm:EscolaViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1326" />
        <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#222A3D" />
        <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#2D3449" />
        <SolidColorBrush x:Key="OnSurfaceBrush" Color="#DAE2FD" />
        <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#C2C6D6" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#ADC6FF" />
        <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#4D8EFF" />
        <SolidColorBrush x:Key="OutlineVariantBrush" Color="#424754" />

        <LinearGradientBrush x:Key="NeoCardGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#171F33" Offset="0" />
            <GradientStop Color="#111B2E" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.neo-card">
            <Setter Property="Background" Value="{StaticResource NeoCardGradientBrush}" />
            <Setter Property="BorderBrush" Value="#1A8C909F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BoxShadow" Value="inset 1 1 0 0 #0DFFFFFF, 8 8 16 0 #66000000" />
        </Style>

        <Style Selector="Button.primario">
            <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.primario:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Botões pequenos de ação (editar/eliminar) dentro dos cartões. -->
        <Style Selector="Button.icone-cartao">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Button.icone-cartao:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#141C2F3D" />
        </Style>

        <!-- Botão secundário (Cancelar) usado nos modais. -->
        <Style Selector="Button.secundario">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerHighestBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.secundario:pointerover">
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <!-- Botão de perigo (Eliminar/confirmação destrutiva) usado nos modais. -->
        <Style Selector="Button.perigo">
            <Setter Property="Background" Value="#C4453B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.perigo:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <!-- Campos de formulário usados dentro dos modais. -->
        <Style Selector="TextBox.campo-modal">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="ComboBox.campo-modal">
            <Setter Property="Background" Value="{StaticResource SurfaceContainerHighBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Faixa de abas horizontal: funciona igual com 1 aba ou com 5, sem alterações. -->
        <Style Selector="ListBox.abas-escola">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.abas-escola ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.abas-escola ListBoxItem">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariantBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ListBox.abas-escola ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#141C2F3D" />
        </Style>
        <Style Selector="ListBox.abas-escola ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryContainerBrush}" />
        </Style>
        <Style Selector="ListBox.abas-escola ListBoxItem:selected">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource BackgroundBrush}" RowDefinitions="Auto,Auto,*">

        <!-- Cabeçalho do módulo -->
        <StackPanel Grid.Row="0" Margin="32,28,32,0" Spacing="4">
            <TextBlock Text="Escola" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource OnSurfaceBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Dashboard" FontSize="12" Opacity="0.6"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="›" FontSize="12" Opacity="0.4"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Escola" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Faixa de abas: Abas define quantas abas existem e em que ordem.
             Trocar de aba só altera AbaItemSelecionada; todo o conteúdo das
             abas vive mais abaixo, no mesmo Grid, ligado por IsVisible. -->
        <Border Grid.Row="1" Margin="32,20,32,0" Padding="6"
                Background="{StaticResource SurfaceContainerHighBrush}"
                CornerRadius="999"
                HorizontalAlignment="Left">
            <ListBox Classes="abas-escola"
                     ItemsSource="{Binding Abas}"
                     SelectedItem="{Binding AbaItemSelecionada}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AbaEscolaItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="16" Height="16" />
                            <TextBlock Text="{Binding Titulo}" FontSize="13" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Conteúdo: um painel por aba, empilhados na mesma célula do Grid;
             só o painel com IsVisible=True ocupa espaço/aparece. -->
        <ScrollViewer Grid.Row="2" Margin="0,16,0,0">
            <Grid>

                <!-- ============================================================ -->
                <!-- ABA "TURMAS" - única com conteúdo real por agora             -->
                <!-- ============================================================ -->
                <StackPanel IsVisible="{Binding AbaTurmasAtiva}" Margin="32,0,32,32" Spacing="24" MaxWidth="1400">

                    <!-- Pesquisa + ação -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding TermoPesquisaTurmas}"
                                PlaceholderText="Procurar por turma, sala ou curso..."
                                Background="{StaticResource SurfaceContainerHighBrush}"
                                Foreground="{StaticResource OnSurfaceBrush}"
                                VerticalAlignment="Center" Padding="10,20"
                                MaxWidth="1060"/>

                        <Button Grid.Column="1" Classes="primario" Command="{Binding NovaTurmaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="PlusCircle" Width="18" Height="18" />
                                <TextBlock Text="Nova Turma" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- KPIs -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
                        <Border Grid.Column="0" Classes="neo-card" Padding="20">
                            <StackPanel Spacing="6">
                                <materialIcons:MaterialIcon Kind="AccountGroup" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding TotalAlunosTurmasTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                                <TextBlock Text="Total de Alunos" FontSize="12" Opacity="0.6" Foreground="{StaticResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="neo-card" Padding="20">
                            <StackPanel Spacing="6">
                                <materialIcons:MaterialIcon Kind="Domain" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding CapacidadeTotalTurmasTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                                <TextBlock Text="Capacidade Total" FontSize="12" Opacity="0.6" Foreground="{StaticResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="neo-card" Padding="20">
                            <StackPanel Spacing="6">
                                <materialIcons:MaterialIcon Kind="DoorOpen" Width="22" Height="22" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="{Binding VagasDisponiveisTurmasTexto}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource OnSurfaceBrush}" />
                                <TextBlock Text="{Binding VagasEmTurmasLabel}" FontSize="12" Opacity="0.6" Foreground="{StaticResource OnSurfaceVariantBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cartões de Turma -->
                    <ItemsControl ItemsSource="{Binding TurmasListadas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TurmaModel">
                                <Border Classes="neo-card" Width="260" Padding="20" Margin="0,0,16,16">
                                    <StackPanel Spacing="14">

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A4D8EFF">
                                                <materialIcons:MaterialIcon Kind="GoogleClassroom" Width="18" Height="18"
                                                                             Foreground="{StaticResource PrimaryBrush}"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource OnSurfaceBrush}" />
                                                <TextBlock Text="{Binding Sala.Nome}" FontSize="11" Opacity="0.6"
                                                           Foreground="{StaticResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="icone-cartao"
                                                    Command="{Binding #RaizEscolaView.((vm:EscolaViewModel)DataContext).EditarTurmaCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Editar turma">
                                                <materialIcons:MaterialIcon Kind="PencilOutline" Width="15" Height="15"
                                                                             Foreground="{StaticResource OnSurfaceVariantBrush}" />
                                            </Button>
                                            <Button Grid.Column="3" Classes="icone-cartao"
                                                    Command="{Binding #RaizEscolaView.((vm:EscolaViewModel)DataContext).EliminarTurmaCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Eliminar turma">
                                                <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="15" Height="15"
                                                                             Foreground="#E0777C" />
                                            </Button>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="Turno" FontSize="12" Opacity="0.6"
                                                       Foreground="{StaticResource OnSurfaceVariantBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding TurnoLabel}" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                                        </Grid>

                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Matriculados" FontSize="12" Opacity="0.6"
                                                           Foreground="{StaticResource OnSurfaceVariantBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding MatriculadosCapacidadeLabel}" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource OnSurfaceBrush}" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding OcupacaoPercentual}"
                                                         Height="6" CornerRadius="3"
                                                         Background="{StaticResource SurfaceContainerHighestBrush}"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                                        </StackPanel>

                                        <Border CornerRadius="6" Padding="8,3" Background="#331AFFB4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding OcupacaoLabel}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                        </Border>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nenhuma turma encontrada para a pesquisa."
                               IsVisible="{Binding SemResultadosTurmas}"
                               Opacity="0.5" FontSize="13" Foreground="{StaticResource OnSurfaceVariantBrush}"
                               HorizontalAlignment="Center" Margin="0,24" />

                </StackPanel>

                <!-- ============================================================ -->
                <!-- ABAS "SALAS" / "CURSOS" / "ANOS LECTIVOS"                     -->
                <!-- ainda sem conteúdo - mesmo placeholder para todas.            -->
                <!-- ============================================================ -->
                <StackPanel IsVisible="{Binding !AbaTurmasAtiva}" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Classes="neo-card" Padding="48" MinWidth="360">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ProgressWrench" Width="40" Height="40"
                                                         Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TituloAbaEmDesenvolvimento}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource OnSurfaceBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Esta aba ainda está em desenvolvimento." FontSize="13" Opacity="0.6"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>

        <!-- ================================================================ -->
        <!-- MODAL "Nova Turma" / "Editar Turma"                               -->
        <!-- ================================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ModalTurmaVisivel}"
                Background="#B3000814" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="neo-card" Padding="28" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer MaxHeight="640">
                <StackPanel Spacing="16">

                    <TextBlock Text="{Binding ModalTurmaTitulo}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource OnSurfaceBrush}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="Ano lectivo" FontSize="12" Opacity="0.7"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <ComboBox Classes="campo-modal" ItemsSource="{Binding AnosLectivosOpcoes}"
                                  SelectedItem="{Binding FormAnoLectivoSelecionado}"
                                  IsEnabled="{Binding !ModalTurmaModoEdicao}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AnoLectivoModel">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Classe" FontSize="12" Opacity="0.7"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <ComboBox Classes="campo-modal" ItemsSource="{Binding ClassesOpcoes}"
                                  SelectedItem="{Binding FormClasseSelecionada}"
                                  IsEnabled="{Binding !ModalTurmaModoEdicao}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ClasseModel">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding CursoAplicavel}">
                        <TextBlock Text="Curso" FontSize="12" Opacity="0.7"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <ComboBox Classes="campo-modal" ItemsSource="{Binding CursosOpcoes}"
                                  SelectedItem="{Binding FormCursoSelecionado}"
                                  IsEnabled="{Binding !ModalTurmaModoEdicao}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:CursoModel">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Sala" FontSize="12" Opacity="0.7"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <ComboBox Classes="campo-modal" ItemsSource="{Binding SalasOpcoes}"
                                  SelectedItem="{Binding FormSalaSelecionada}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:SalaModel">
                                    <TextBlock Text="{Binding Nome}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Turno" FontSize="12" Opacity="0.7"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <ComboBox Classes="campo-modal" ItemsSource="{Binding TurnoOpcoes}"
                                  SelectedItem="{Binding FormTurnoSelecionado}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TurnoOpcao">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Capacidade" FontSize="12" Opacity="0.7"
                                   Foreground="{StaticResource OnSurfaceVariantBrush}" />
                        <TextBox Classes="campo-modal" Text="{Binding FormCapacidadeTurma}"
                                 PlaceholderText="Ex.: 40" />
                    </StackPanel>

                    <Border CornerRadius="10" Padding="12,10" Background="#141C2F3D"
                            IsVisible="{Binding !!FormNomePreview}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Nome gerado automaticamente" FontSize="11" Opacity="0.6"
                                       Foreground="{StaticResource OnSurfaceVariantBrush}" />
                            <TextBlock Text="{Binding FormNomePreview}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ModalTurmaErro}"
                               IsVisible="{Binding !!ModalTurmaErro}"
                               FontSize="12" Foreground="#E0777C" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Classes="secundario" Content="Cancelar"
                                Command="{Binding CancelarModalTurmaCommand}" Margin="0,0,10,0" />
                        <Button Grid.Column="2" Classes="primario" Content="Guardar"
                                Command="{Binding SalvarTurmaCommand}" />
                    </Grid>

                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <!-- ================================================================ -->
        <!-- MODAL "Eliminar Turma" (confirmação)                              -->
        <!-- ================================================================ -->
        <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ModalEliminarTurmaVisivel}"
                Background="#B3000814" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Classes="neo-card" Padding="28" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="18">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="24" Height="24" Foreground="#E0777C" />
                        <TextBlock Text="Eliminar turma" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource OnSurfaceBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource OnSurfaceVariantBrush}">
                        <Run Text="Tem a certeza que deseja eliminar a turma" />
                        <Run Text="{Binding ModalEliminarTurmaNome}" FontWeight="SemiBold" />
                        <Run Text="? Esta ação não pode ser desfeita." />
                    </TextBlock>

                    <TextBlock Text="{Binding ModalEliminarTurmaErro}"
                               IsVisible="{Binding !!ModalEliminarTurmaErro}"
                               FontSize="12" Foreground="#E0777C" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Button Grid.Column="1" Classes="secundario" Content="Cancelar"
                                Command="{Binding CancelarEliminarTurmaCommand}" Margin="0,0,10,0" />
                        <Button Grid.Column="2" Classes="perigo" Content="Eliminar"
                                Command="{Binding ConfirmarEliminarTurmaCommand}" />
                    </Grid>

                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
